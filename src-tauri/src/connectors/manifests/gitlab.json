{
  "manifest": 1,
  "id": "gitlab",
  "name": "GitLab",
  "kind": "http",
  "capabilities": ["network", "secrets"],
  "auth": { "type": "bearer", "secret": "gitlab_token" },
  "baseUrl": "https://gitlab.com",
  "operations": {
    "listProjects": {
      "request": {
        "method": "GET",
        "path": "/api/v4/projects",
        "query": {
          "membership": "true",
          "simple": "true",
          "order_by": "last_activity_at",
          "per_page": "100"
        }
      },
      "response": {
        "items": "",
        "map": {
          "id": "id",
          "name": "name_with_namespace",
          "description": "description"
        }
      }
    },
    "listTasks": {
      "request": {
        "method": "GET",
        "path": "/api/v4/projects/{{project.id}}/issues",
        "query": { "scope": "all", "per_page": "100" }
      },
      "response": {
        "items": "",
        "map": {
          "id": "id",
          "label": "title",
          "url": "web_url",
          "status": "state",
          "done": "closed_at"
        }
      }
    }
  }
}
