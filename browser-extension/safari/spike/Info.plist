<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Embedded into the probe's __TEXT,__info_plist section so the
	     ad-hoc-signed CLI tool has a CFBundleIdentifier. Without one,
	     `secinit` cannot associate a sandbox container and App Sandbox
	     activation is unreliable. With it, the kernel sets up
	     ~/Library/Containers/io.drmowinckels.cairn.spike.probe and the
	     `diag` subcommand can observe the rewritten HOME. -->
	<key>CFBundleIdentifier</key>
	<string>io.drmowinckels.cairn.spike.probe</string>
	<key>CFBundleName</key>
	<string>SpikeProbe</string>
	<key>CFBundleExecutable</key>
	<string>socket_probe</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
</dict>
</plist>
